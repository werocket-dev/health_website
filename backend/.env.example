# Backend WeRocket — variables d'environnement
# Copier en .env et compléter. Chargé via python-dotenv (load_dotenv()).

# Connexion PostgreSQL (Supabase Cloud) — même base que le frontend
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vickcezkxflccwbgdvpy.supabase.co:5432/postgres

# Agent WordPress WeRocket (plugin custom, auth HMAC-SHA256)
# Sans ces deux variables, le backend bascule automatiquement en mode
# scraping HTML dégradé (voir audit_engine.py: AGENT_AVAILABLE).
WEROCKET_AGENT_TOKEN=
WEROCKET_AGENT_HEADER_KEY=

# Sentry — Monitoring des erreurs (optionnel)
# Créer un projet sur https://sentry.io (tier gratuit suffisant)
# Laisser vide pour désactiver.
SENTRY_DSN=
ENVIRONMENT=development
