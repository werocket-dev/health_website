# Backend WeRocket — variables d'environnement
# Copier en .env et compléter. Chargé via python-dotenv (load_dotenv()).

# Agent WordPress WeRocket (plugin custom, signature Ed25519)
# Sans WEROCKET_PRIVATE_KEY_HEX, le backend bascule automatiquement en mode
# scraping HTML dégradé (voir audit_engine.py: AGENT_AVAILABLE).
# Clé privée Ed25519 : seed de 32 octets en hexadécimal (64 caractères). La clé
# publique correspondante va dans wp-config.php des sites (WEROCKET_PUBLIC_KEY_HEX).
WEROCKET_PRIVATE_KEY_HEX=
# Clé secrète du header X-WeRocket-Key — identique à WEROCKET_AGENT_HEADER_KEY dans wp-config.php.
WEROCKET_AGENT_HEADER_KEY=

# Sentry — Monitoring des erreurs (optionnel)
# Créer un projet sur https://sentry.io (tier gratuit suffisant)
# Laisser vide pour désactiver.
SENTRY_DSN=
ENVIRONMENT=development
# Part des requêtes tracées par Sentry (0 à 1). 0.1 par défaut : 1.0 coûte cher en production.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sécurité API — clé secrète exigée (header X-API-Key) sur toutes les routes
# /api/*. Doit être identique à BACKEND_API_KEY côté frontend (proxy serveur).
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=

# URL du frontend, pour restreindre le CORS (n'est plus le chemin d'accès
# principal depuis que le frontend passe par son proxy serveur, mais reste
# utile en garde-fou / pour des tests directs).
FRONTEND_URL=http://localhost:3000

# --- Installation de Breakdance depuis un zip (GPL) ---
# URL publique du backend (http ou https) : l'agent WP y télécharge le zip (/dl/breakdance/{token}).
# Rien à configurer sur les sites : l'agent (≥ 3.5.0) vérifie la signature Ed25519 de l'URL
# (WEROCKET_ZIP_ALLOWED_HOSTS reste possible, en durcissement facultatif).
PUBLIC_BACKEND_URL=http://backend.exemple.com
# Ajout d'un plugin quelconque (onglet « Ajouter un plugin » du récap) : l'URL ci-dessus doit être en
# https:// (un plugin peut être premium, son lien de téléchargement ne doit pas circuler en clair).
# PLUGIN_ZIP_ALLOW_HTTP=1 lève cette exigence en connaissance de cause. Breakdance n'est pas concerné.
# PLUGIN_ZIP_ALLOW_HTTP=
# Secret HMAC des liens de téléchargement (facultatif : dérivé de BACKEND_API_KEY si absent).
BREAKDANCE_DL_SECRET=
