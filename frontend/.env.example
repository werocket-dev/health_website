# Frontend WeRocket — variables d'environnement serveur (jamais NEXT_PUBLIC_*,
# sinon elles finiraient dans le bundle JS envoyé au navigateur).
# Copier en .env et compléter.

# URL du backend FastAPI, jamais exposée au navigateur — seul ce serveur
# Next.js l'appelle (via app/api/backend/[...path]/route.ts).
BACKEND_URL=http://localhost:8000

# Doit être identique à BACKEND_API_KEY côté backend.
BACKEND_API_KEY=

# Mot de passe unique pour accéder au dashboard (outil interne, pas de comptes
# multi-utilisateurs).
DASHBOARD_PASSWORD=

# Secret de signature des cookies de session (JWT). Générer avec :
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
